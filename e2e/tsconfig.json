{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@playwright/test", "node"],
    "noEmit": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "fixtures/**/*.ts"]
}
