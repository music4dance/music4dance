{
  "name": "m4d-client",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn type-check && yarn build-only",
    "full-build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/junit.xml",
    "test:ui": "vitest --ui --api 9527",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint --fix src",
    "lint:ci": "eslint src --max-warnings 0",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "axios": "1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "1.2.1",
    "date-fns": "^4.4.0",
    "focus-trap": "8.2.2",
    "jquery": "^4.0.0",
    "jquery-validation": "^1.22.1",
    "jquery-validation-unobtrusive": "^4.0.0",
    "markdowndeep": "^1.6.12",
    "typedjson": "^1.8.0",
    "uuid": "^14.0.2",
    "vue": "3.5.43",
    "vue-showdown": "^4.2.0"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@tsconfig/node18": "^18.2.7",
    "@types/bootstrap": "^5.2.11",
    "@types/jquery": "^4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.2",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/utils": "8.70.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "5.0.1",
    "@vue/compiler-dom": "3.5.43",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/server-renderer": "3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "jsdom": "30.1.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.8",
    "sass": "1.104.1",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.3.0",
    "vite-plugin-inspect": "12.0.2",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.11"
  },
  "resolutions": {
    "strip-ansi": "6.0.1",
    "string-width": "4.2.2",
    "wrap-ansi": "7.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
