@using m4d.ViewModels
@using m4dApi
@using m4d.PublicApi
@model PartnerUsageModel

@{
    ViewBag.Title = $"Partner API Usage: {Model.Client.Name}";
    ViewBag.BreadCrumbs = Model.IsAdmin
        ? BreadCrumbItem.BuildAdminTrail(ViewBag.Title)
        : BreadCrumbItem.BuildInfoTrail(ViewBag.Title);
    var report = Model.Report;
    var client = Model.Client;
    var scale = Math.Max(report.Largest, 1);

    string Limit(double? value, double builtIn, string format = "N0") =>
        value.HasValue ? value.Value.ToString(format) : $"{builtIn.ToString(format)} (default)";
}

<h1>@ViewBag.Title</h1>

<p>
    Calls to the music4dance partner API by <strong>@client.Name</strong> (<code>@client.Id</code>)
    over the last @PartnerUsageReport.TrailingDays days. Days are UTC. Today's row is still filling in,
    and runs up to a minute behind.
</p>

@if (!Model.Connected)
{
    <div class="alert alert-warning">
        <code>PartnerApi:UsageTableUri</code> isn't set on this site, so there's no usage to show.
    </div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Calls, last @PartnerUsageReport.TrailingDays days</div>
            <div class="fs-4">@report.Total.ToString("N0")</div>
            <div class="small">@report.AveragePerDay.ToString("N0") a day on average</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Busiest day</div>
            <div class="fs-4">@(report.Busiest?.Total.ToString("N0") ?? "–")</div>
            <div class="small">@(report.Busiest?.Day.ToString("MMM d") ?? "no calls yet")</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Days over the soft limit</div>
            <div class="fs-4">@report.DaysOverSoftCap</div>
            <div class="small">of @report.SoftCap.ToString("N0") a day</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Turned away (429)</div>
            <div class="fs-4">@((report.RateLimited + report.CapLimited).ToString("N0"))</div>
            <div class="small">
                rate limit: @report.RateLimited.ToString("N0") in @report.RateLimitedMinutes.ToString("N0") minute(s);
                daily cap: @report.CapLimited.ToString("N0")
            </div>
        </div></div>
    </div>
</div>

<h2 class="h5">Limits</h2>
<ul>
    <li>Rate: @Limit(client.RatePerSecond, PartnerDefaults.BuiltInRate, "N1") requests a second, burst @Limit(client.Burst, PartnerDefaults.BuiltInBurst). Past these a request gets <code>429</code> with <code>Retry-After</code> in seconds.</li>
    <li>Daily cap: @Limit(client.DailyCap, PartnerDefaults.BuiltInDailyCap) calls. Past it, requests get <code>429</code> until UTC midnight.</li>
    <li>Soft limit: @Limit(client.SoftCap, PartnerDefaults.BuiltInSoftCap) calls a day. Nothing is refused; music4dance is alerted so we can talk about raising limits well before the cap.</li>
</ul>

<h2 class="h5">By day</h2>
<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Day (UTC)</th>
                <th class="text-end">Calls</th>
                <th style="width: 30%"></th>
                <th class="text-end" title="Matched on an id the partner sent">Exact</th>
                <th class="text-end" title="The ids pointed at different songs">Ambiguous</th>
                <th class="text-end" title="Matched on title and artist only">Fuzzy</th>
                <th class="text-end" title="No match">None</th>
                <th class="text-end" title="Requests the rate limit turned away, and the minutes in which it did">Rate limited</th>
                <th class="text-end" title="Requests the daily cap turned away">Over cap</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var day in report.Days)
            {
                var rowClass = day.CapLimited > 0 ? "table-danger" : day.Total >= report.SoftCap ? "table-warning" : "";
                <tr class="@rowClass">
                    <td>
                        @day.Day.ToString("ddd MMM d")
                        @if (day.Day == report.Today)
                        {
                            <span class="badge bg-secondary ms-1">so far</span>
                        }
                    </td>
                    <td class="text-end">@day.Total.ToString("N0")</td>
                    <td>
                        @if (day.Total > 0)
                        {
                            <div class="bg-primary rounded" style="height: 0.6rem; width: @((100.0 * day.Total / scale).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        }
                    </td>
                    <td class="text-end">@day.Exact.ToString("N0")</td>
                    <td class="text-end">@day.Ambiguous.ToString("N0")</td>
                    <td class="text-end">@day.Fuzzy.ToString("N0")</td>
                    <td class="text-end">@day.None.ToString("N0")</td>
                    <td class="text-end">
                        @if (day.RateLimited > 0)
                        {
                            @($"{day.RateLimited:N0} in {day.RateLimitedMinutes:N0} min")
                        }
                        else
                        {
                            @:0
                        }
                    </td>
                    <td class="text-end">@day.CapLimited.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="form-text">
    Yellow rows passed the soft limit; red rows reached the daily cap. Rate-limited minutes are counted
    per API instance, so one busy minute can count twice.
</p>

<p>
    @Html.ActionLink("Back to " + (Model.IsAdmin ? "Partner API Clients" : "Partner API Keys"),
        Model.IsAdmin ? "Clients" : "Index", "PartnerKeys")
</p>
