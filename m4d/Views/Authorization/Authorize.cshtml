@model m4d.PublicApi.AuthorizationViewModel
@{
    ViewData["Title"] = "Connect " + Model.ApplicationName;
    ViewData["HideAds"] = true;
    ViewData["NoWarnings"] = true;
    ViewData["NoIndex"] = true;
}

<main class="row justify-content-center my-4">
    <section class="col-12 col-md-8 col-lg-6" aria-labelledby="consent-title">
        <h1 id="consent-title">Connect @Model.ApplicationName</h1>
        <p>Signed in to music4dance as <strong>@Model.UserName</strong>.</p>
        <p>@Model.ApplicationName would like permission to:</p>
        <ul>
            @foreach (var permission in Model.Permissions)
            {
                <li>@permission</li>
            }
        </ul>
        <p>Your password stays with music4dance. @Model.ApplicationName cannot change your music4dance data.</p>
        <p>You can disconnect the app at any time under <a href="~/Identity/Account/Manage/ConnectedApps">Connected Apps</a>.</p>
        <form method="post" action="@Url.Content("~/connect/authorize")" asp-antiforgery="true">
            <input type="hidden" name="client_id" value="@Model.ClientId" />
            <input type="hidden" name="request_uri" value="@Model.RequestUri" />
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" name="decision" value="accept" class="btn btn-primary">Allow access</button>
                <button type="submit" name="decision" value="deny" class="btn btn-outline-secondary">Not now</button>
            </div>
        </form>
    </section>
</main>
