@using m4d.Utilities
@using m4d.ViewModels
@using m4dModels
@using Microsoft.EntityFrameworkCore.Infrastructure.Internal

@inject ISearchServiceManager SearchService

@{
    ViewBag.Title = "InitializationTasks";
    ViewBag.BreadCrumbs = BreadCrumbItem.BuildAdminTrail(ViewBag.Title);
}

<h3>Search Indexing</h3>
<ul>
    <li>
        Artist index page (<code>ArtistIndex</code> feature flag):
        @if (ViewBag.ArtistIndexEnabled == true)
        {
            <strong class="text-success">on</strong>
        }
        else
        {
            <strong class="text-secondary">off</strong>
            <text>- artist pages and /song/artists still use the Artist credit</text>
        }
    </li>
    @foreach (var id in SearchService.GetAvailableIds()){
        <li>
            @id: @Html.ActionLink("Reset", "ResetSearchIdx", new { id = id }, null)
            @using (Html.BeginForm("ReloadAllSongs", "Admin", FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("idxName", id)
                <input type="submit" value="Reload All Songs"
                       onclick="return confirm('Reload every song in @id in place? This re-reads and re-saves the whole index.');" />
            }
            @using (Html.BeginForm("AddIndexFields", "Admin", FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("idxName", id)
                <input type="submit" value="Add Missing Fields"
                       onclick="return confirm('Add any new fields (e.g. Artists) to @id in place?');" />
            }
            <br />
            @{
                var artistsStatus =
                    ViewBag.ArtistsFieldStatus as Dictionary<string, (bool Present, DateTime? RefreshesAt)>;
                var status = artistsStatus != null && artistsStatus.TryGetValue(id, out var s)
                    ? s
                    : (Present: false, RefreshesAt: (DateTime?)null);
            }
            <small class="text-muted">
                Artists field:
                @if (status.Present)
                {
                    <strong class="text-success">present</strong>
                }
                else
                {
                    <strong class="text-warning">absent</strong>
                    <text>- run Add Missing Fields</text>
                }
                @{
                    var coverage = ViewBag.ArtistsCoverage as Dictionary<string, (long Total, long? WithArtists)>;
                    var counts = coverage != null && coverage.TryGetValue(id, out var c)
                        ? c
                        : ((long Total, long? WithArtists)?)null;
                }
                @if (counts?.WithArtists is long populated)
                {
                    var missing = counts.Value.Total - populated;
                    <text>
                        &mdash; <strong>@populated.ToString("N0")</strong> of
                        @counts.Value.Total.ToString("N0") songs populated
                    </text>
                    @if (missing > 0)
                    {
                        <text>
                            (<strong class="text-warning">@missing.ToString("N0") still empty</strong>
                            - run the backfill below)
                        </text>
                    }
                }
                @if (status.RefreshesAt.HasValue)
                {
                    var wait = status.RefreshesAt.Value - DateTime.UtcNow;
                    <text>
                        (this instance re-reads the schema
                        @(wait > TimeSpan.Zero ? $"in {wait.TotalMinutes:F0} min" : "on the next call");
                        others may lag by up to @SearchServiceInfo.SchemaCacheDuration.TotalMinutes min)
                    </text>
                }
            </small>
            <br />
            Individual artists:
            @foreach (var mode in new[] { "Report", "Apply", "ApplyChanged" })
            {
                using (Html.BeginForm("BatchArtists", "Admin", FormMethod.Post, new { style = "display:inline" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("idxName", id)
                    @Html.Hidden("mode", mode)
                    <input type="submit" value="@mode"
                           onclick="return confirm('Run the artist splitter over @id in @mode mode?');" />
                }
            }
        </li>
    }

</ul>

@if (SearchService.HasNextVersion && !SearchService.NextVersion) {
    @Html.ActionLink($"Update {SearchService.DefaultId} → {SearchService.NextIndexName}", "UpdateSearchIdx")
}

<h3 class="mt-3"> Initializiation Tasks</h3>
<ul>
    <li>
        Reload Song Stats
        <ul>
            <li>@Html.ActionLink("From Store", "ClearSongCache")</li>
            <li>
                @Html.ActionLink("From File", "ClearSongCache", new
            {
                reloadFromStore = false
            }, null)
            </li>
        </ul>
    </li>
    <li>@Html.ActionLink("Reload Dances", "ReloadDances")</li>
    <li>
        @using (Html.BeginForm("ExportDanceFallback", "Admin", FormMethod.Post, new { style = "display:inline" }))
        {
            @Html.AntiForgeryToken()
            <input type="submit" value="Export Dance Fallback"
                   onclick="return confirm('Overwrite the checked-in dance-environment-fallback.json with the current in-memory dance stats?');" />
        }
    </li>
    <li>@Html.ActionLink("Update Sitemap", "UpdateSitemap")</li>
</ul>

<h3>Update Warning</h3>
@using (Html.BeginForm("UpdateWarning", "Admin", FormMethod.Post, new
{
enctype = "multipart/form-data"
}))
{
    @Html.AntiForgeryToken()
    @if (string.IsNullOrWhiteSpace(GlobalState.UpdateMessage))
{
    <textarea name="message" id="mesage" rows="4" cols="100">
            We are in the process of upgrading the music4dance.net infrastructure.
            You should still be able to use the site to browse and search but please
            hold off doing any editing or registering an account until this banner disappears.
            Thanks!
        </textarea>
    <input type="submit" name="submit" id="Update" value="Update"/>
}
else
{
    <p>Current Update: @GlobalState.UpdateMessage</p>
    <input type="hidden" name="message" id="message" value=""/>
    <input type="submit" name="clear" id="cear" value="Clear" />
}
}

<h3>Test Keys</h3>
<ul>
    <li>
        Using Test Keys = @GlobalState.UseTestKeys;  <a href="/admin/toggletestkeys">Toggle</a>
    </li>
</ul>

<h3>Clean Up</h3>
<ul>
    <li>
        @Html.ActionLink("Cleanup Properties", "CleanupProperties", new
    {
        count = 100
    }, null)
    </li>
</ul>

<h3>Merging</h3>
<ul>
    <li>
        @Html.ActionLink("Merge Candidates - Similar Title", "MergeCandidates", "Song", new
    {
        level = 2
    }, null)
    </li>
    <li>
        @Html.ActionLink("Merge Candidates - Similar (Title + Artist) + All else equal", "MergeCandidates", "Song", new
    {
        level = 1
    }, null)
    </li>
    <li>
        @Html.ActionLink("Merge Candidates - Similar (Title + Artist + Length) + All else equal", "MergeCandidates", "Song", new
    {
        level = 3
    }, null)
    </li>
    <li>
        @Html.ActionLink("Merge Candidates - Similar Title + All else equal", "MergeCandidates", "Song", new
    {
        level = 0
    }, null)
    </li>
    <li>@Html.ActionLink("Finish Merge Session", "ClearMergeCache", "Song")</li>
    <li>
        @Html.ActionLink("AutoMerge", "MergeCandidates", "Song", new
    {
        level = 3,
        autocommit = true
    }, null)
    </li>
</ul>

<h4>Merge Songs</h4>
@using (Html.BeginForm("BulkEdit", "Song", FormMethod.Post, new
{
enctype = "multipart/form-data"
}))
{
    @Html.AntiForgeryToken()

    <input
        type="text"
        value="54a3db2a-7c17-47e1-bd39-11ddc079918d"
        name="selectedSongs"
    />
    <input type="text"
       value="130bb268-a7a6-4b3c-890a-708051e786bb"
       name="selectedSongs" />
    <input type="submit" id="SimpleMerge" name="action" value="SimpleMerge" />
    <input type="submit" id="Preview" name="action" value="Preview" />
}


<h3>Old Tasks</h3>
<ul>
    @if (User.IsInRole("dbAdmin"))
{
    <li>@Html.ActionLink("Restore the Datbase", "RestoreDatabase")</li>
    <li>@Html.ActionLink("Rerun seed function", "Reseed")</li>
}
</ul>
