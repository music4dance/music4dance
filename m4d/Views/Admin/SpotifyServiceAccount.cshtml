@using m4d.Services
@using m4d.ViewModels
@using m4dModels
@model ServiceAccountToken

@{
    ViewBag.Title = "Spotify Service Account";
    ViewBag.BreadCrumbs = BreadCrumbItem.BuildAdminTrail(ViewBag.Title);
    var now = DateTimeOffset.UtcNow;
}

<h1>@ViewBag.Title</h1>

<p>
    The scheduled <code>UpdateBatch?type=SpotifyFromSearch</code> runs write to the music4dance
    Spotify account's playlists as this account. Spotify ends the connection six months after it's
    made, so reconnect it when the expiry email arrives.
</p>

@if (!string.IsNullOrEmpty(ViewBag.Message))
{
    <div class="alert alert-info">@ViewBag.Message</div>
}

@if (Model == null)
{
    <div class="alert alert-warning">Not connected.</div>
}
else
{
    var warning = now >= Model.ExpiresAt - ServiceAccountMonitor.WarningWindow;
    <table class="table table-sm w-auto">
        <tr><th>Spotify account</th><td>@Model.AccountName (@Model.AccountId)</td></tr>
        <tr><th>Scopes</th><td>@Model.Scopes</td></tr>
        <tr><th>Connected</th><td>@Model.AuthorizedAt.ToString("yyyy-MM-dd HH:mm") UTC by @Model.AuthorizedBy</td></tr>
        <tr>
            <th>Expires</th>
            <td class="@(warning ? "text-danger fw-bold" : "")">
                @Model.ExpiresAt.ToString("yyyy-MM-dd")
                (@((int)Math.Ceiling((Model.ExpiresAt - now).TotalDays)) days)
            </td>
        </tr>
        <tr>
            <th>Status</th>
            <td>
                @if (Model.IsValid)
                {
                    <span class="text-success">Valid</span>
                }
                else
                {
                    <span class="text-danger">
                        Rejected @Model.InvalidatedAt?.ToString("yyyy-MM-dd HH:mm") UTC: @Model.InvalidReason
                    </span>
                }
            </td>
        </tr>
        <tr><th>Last alert</th><td>@(Model.LastAlertSent?.ToString("yyyy-MM-dd HH:mm") ?? "none")</td></tr>
    </table>
}

<p>
    Choosing Connect opens Spotify's sign-in dialog. Sign in there as the <strong>music4dance</strong>
    Spotify account (use "Not you?" if it shows your own); your site login doesn't change.
</p>
<a class="btn btn-primary" href="@Url.Action("ConnectSpotifyServiceAccount")">
    @(Model == null ? "Connect" : "Reconnect")
</a>
