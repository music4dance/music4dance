@using m4d.Services
@using m4d.ViewModels
@using m4dModels
@model SharedIdPreview

@{
    ViewBag.Title = "Merge Preview";
    ViewBag.BreadCrumbs = BreadCrumbItem.BuildAdminTrail(ViewBag.Title);
}

<h1>@ViewBag.Title</h1>

<p>
    What the three Merge all tasks on @Html.ActionLink("Shared Song Ids", "Index") would do with
    each pending cluster, and the title, artist and individual artists each merge would land on.
    Nothing was merged. Merges and reviews made since the preview ran aren't reflected here: run
    <strong>Preview merges</strong> again to see them. A cluster with a rejected pair, a .NoMerge
    song, a song with no artist, or lengths more than @SharedIdMatcher.LengthTolerance seconds
    apart (probably different recordings) is skipped by all of them.
</p>

@if (Model == null)
{
    <p>No preview has run since the server started.</p>
}
else
{
    var merges = Model.Merges.ToList();
    var featuring = Model.FeaturingMerges.ToList();
    var credits = Model.CreditMerges.ToList();
    var skips = Model.Skips.ToList();
    <p>
        Run @Model.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm"):
        @Model.Plans.Count.ToString("N0") clusters.
    </p>
    <ul>
        <li><a href="#merge">Matching title and artist</a>: @merges.Count.ToString("N0")</li>
        <li><a href="#merge-feat">Differ only by feat.</a>: @featuring.Count.ToString("N0")</li>
        <li><a href="#merge-credits">Artists credited differently</a>: @credits.Count.ToString("N0")</li>
        @for (var i = 0; i < skips.Count; i++)
        {
            <li><a href="#skip-@i">Skipped: @skips[i].Key</a>: @skips[i].Count().ToString("N0")</li>
        }
    </ul>

    <h2 id="merge">Matching title and artist</h2>
    <p>
        What <strong>Merge all with matching title and artist</strong> would merge. A feat. clause
        in the titles still moves into the individual artists.
    </p>
    @using (Html.BeginForm("MergeMatching", "SharedIds", FormMethod.Post,
        new { @class = "mb-3", onsubmit = "return confirm('Merge every cluster with a matching title and artist?')" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Merge all with matching title and artist</button>
    }
    @await Html.PartialAsync("_SharedIdPlans", merges)

    <h2 id="merge-feat">Differ only by feat.</h2>
    <p>
        What <strong>Merge all that differ only by feat.</strong> would merge: the titles and
        artists are the same once their feat. clauses come out. The featured artists move into the
        individual artists, and the artist credit is one that names all of them when one of the
        songs has it.
    </p>
    @using (Html.BeginForm("MergeFeaturing", "SharedIds", FormMethod.Post,
        new { @class = "mb-3", onsubmit = "return confirm('Merge every cluster that differs only by feat.?')" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Merge all that differ only by feat.</button>
    }
    @await Html.PartialAsync("_SharedIdPlans", featuring)

    <h2 id="merge-credits">Artists credited differently</h2>
    <p>
        What <strong>Merge all with artists credited differently</strong> would merge: the titles
        are the same without feat., and either every song names the same artists however they're
        credited ("X and His Orchestra" and "X", "X &amp; Y" and "Y and X"), or some credits leave
        artists out ("X" and "X &amp; Y") and each song credited to the lead artist alone has a
        Spotify or iTunes track of its own (an id the other songs don't share) that lists them all.
        When that track leaves artists out, the cluster is skipped as probably a different
        recording.
        The merged song keeps every artist.
    </p>
    @using (Html.BeginForm("MergeCredits", "SharedIds", FormMethod.Post,
        new { @class = "mb-3", onsubmit = "return confirm('Merge every cluster whose artists are only credited differently?')" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Merge all with artists credited differently</button>
    }
    @await Html.PartialAsync("_SharedIdPlans", credits)

    @for (var i = 0; i < skips.Count; i++)
    {
        <h2 id="skip-@i">Skipped: @skips[i].Key</h2>
        @await Html.PartialAsync("_SharedIdPlans", skips[i].ToList())
    }
}
