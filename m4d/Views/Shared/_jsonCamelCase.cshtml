@using m4d.Utilities
@model m4d.ViewModels.ObjectConverterModel

@{
    // ScriptJson escapes <, > and & so a value containing "</script>" can't close this block.
    // A string model is emitted as a JavaScript string literal.
    var json = ScriptJson.Serialize(Model.Model, camelCase: !Model.PreserveCase, indented: true);
}

<script>var @Model.Name = @Html.Raw(json);</script>
